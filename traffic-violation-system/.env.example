# Application Settings
APP_NAME="Smart Traffic Violation Detection API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Falls back to SQLite if PostgreSQL is not available)
DATABASE_URL=sqlite:///./test.db
# PostgreSQL option: postgresql://postgres:postgres@localhost:5432/traffic_violations

# Email Notification Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_RECIPIENT_EMAIL=""

# Processing Hardware (auto, cpu, cuda)
DEVICE=auto
